# ============================================================================
# CareCompass Staging Backend Environment Configuration
# ISOLATION GUARANTEE: Never use production Supabase credentials in staging.
# ============================================================================

NODE_ENV=staging
PORT=10000

# Separate Supabase Staging Database Connection String (Transaction Pooler - IPv4 supported)
# Replace with your staging project reference (e.g., [staging-project-ref])
DATABASE_URL=postgresql://postgres.[staging-project-ref]:[staging-password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Staging Connection Pool Settings
DB_POOL_MAX=5
DB_TIMEOUT_MS=10000
DATABASE_SSL=true

# Staging Cryptographic Signing Secret (Distinct from production)
JWT_SECRET=carecompass_staging_jwt_secret_must_be_random_64_bytes_long

# Staging Admin Bootstrap
ADMIN_EMAIL=admin@staging.carecompass.org
ADMIN_INITIAL_PASSWORD=StagingAdmin#2026!Secure

# Allowed Staging Origins for CORS
FRONTEND_URL=https://carecompass-staging.vercel.app
ALLOWED_ORIGINS=https://carecompass-staging.vercel.app,https://*.vercel.app,http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
