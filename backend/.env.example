# CareCompass Backend Environment Configuration (Render)

# Environment Mode: development | production
NODE_ENV=production

# Server Port (Render automatically sets PORT, default is 10000)
PORT=10000

# Supabase PostgreSQL Database Connection String
# Get this from: Supabase Project Dashboard -> Project Settings -> Database -> Connection string -> URI
# Modes supported:
# - Direct connection (port 5432): postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# - Connection pooler (port 6543): postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Connection Pool Settings
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
DATABASE_SSL=true

# Allowed Frontend Origins for CORS (Vercel deployment & local dev)
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Razorpay Online Payment Integration (Subject to merchant onboarding & test mode)
# In development & staging, test keys are used. NEVER expose secret keys to the frontend.
RAZORPAY_KEY_ID=rzp_test_CareCompassSampleKey
RAZORPAY_KEY_SECRET=carecompass_test_secret_123456
RAZORPAY_WEBHOOK_SECRET=carecompass_webhook_secret_789

